{
  "name": "cards_house",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir web-build",
    "build:web:gh-pages": "expo export --platform web --output-dir web-build",
    "prebuild": "env -u GEM_HOME -u GEM_PATH PATH=\"/usr/local/bin:/opt/homebrew/bin:$PATH\" npx expo prebuild",
    "run:android": "npx expo run:android",
    "run:ios": "env -u GEM_HOME -u GEM_PATH PATH=\"/usr/local/bin:/opt/homebrew/bin:$PATH\" npx expo run:ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage-report": "jest --coverage && open coverage/lcov-report/index.html"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.1.3",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-native-fontawesome": "^0.3.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^5.1.1",
    "@react-navigation/native": "^6.1.10",
    "@react-navigation/stack": "^6.3.21",
    "ci": "^2.3.0",
    "expo": "~50.0.20",
    "expo-blur": "~12.9.2",
    "expo-linear-gradient": "~12.7.2",
    "expo-status-bar": "~1.11.1",
    "expo-system-ui": "~2.9.4",
    "moti": "^0.30.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "^3.29.0",
    "react-native-svg": "^14.1.0",
    "react-native-web": "~0.19.6",
    "react-native-worklets": "^0.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "jest-expo": "^50.0.0",
    "react-test-renderer": "18.2.0"
  },
  "private": true
}
